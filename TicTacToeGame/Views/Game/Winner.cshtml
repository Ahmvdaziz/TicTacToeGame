@{
    ViewData["Title"] = "Winner";
}
<body>
    <!-- 🎥 الفيديو كخلفية -->
    <video autoplay muted loop id="backgroundVideo" class="background-video">
        <source src="/videos/PP.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>

    <!-- 🎉 خلفية متحركة -->
    <div class="celebration-bg">
        <h2 class="game-over">🎉 Game Over! 🎉</h2>

        @if (ViewBag.Winner == "Draw")
        {
            <h3 class="draw-message">It's a Draw! 🤝</h3>
        }
        else
        {
            <h3 class="winner-message">🏆 Player @ViewBag.Winner Wins! 🎊</h3>
        }

        <a href="@Url.Action("Index", "Game")" class="play-again-btn">🔄 Play Again</a>
        <a href="@Url.Action("Index", "Home")" class="back-home-btn">🏠 Back to Home</a>
    </div>

    <audio id="winSound" src="/sounds/winner.m4a"></audio>
    <audio id="drawSound" src="/sounds/draw.mp3"></audio>
    <audio id="celebrationSound" src="/sounds/winner.m4a"></audio>

    <div class="confetti-container"></div>

    <script>
        window.onload = function () {
            let winner = "@ViewBag.Winner";
            let celebrationSound = document.getElementById("celebrationSound");

            if (winner === "Draw") {
                document.getElementById("drawSound").play();
            } else {
                document.getElementById("winSound").play();
            }

            setTimeout(() => {
                celebrationSound.play();
            }, 500);

            startConfetti();
        };

        function startConfetti() {
            const confettiContainer = document.querySelector(".confetti-container");

            for (let i = 0; i < 100; i++) {
                let confetti = document.createElement("div");
                confetti.classList.add("confetti");
                confetti.style.left = Math.random() * 100 + "vw";
                confetti.style.animationDuration = (Math.random() * 3 + 2) + "s";
                confetti.style.backgroundColor = `hsl(${Math.random() * 360}, 100%, 50%)`;
                confettiContainer.appendChild(confetti);
            }
        }
    </script>

    <style>
        /* خلفية الفيديو */
        .background-video {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -1;
        }

        body {
            font-family: 'Poppins', sans-serif;
            text-align: center;
            background: black;
            color: white;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        .celebration-bg {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            background: url('/images/fireworks.gif') no-repeat center center/cover;
        }

        .game-over {
            font-size: 50px;
            font-weight: bold;
            color: #ffcc00;
            text-shadow: 0 0 30px #ffcc00;
            animation: glow 1.5s infinite alternate;
            margin-top: -50px; /* ✅ تحريك Game Over لفوق شويه */
        }


        .winner-message, .draw-message {
            font-size: 36px;
            font-weight: bold;
            text-shadow: 0 0 20px #fff;
            animation: popUp 1s ease-in-out;
        }

        .winner-message {
            color: #4caf50;
        }

        .draw-message {
            color: #ff9800;
        }

        .play-again-btn, .back-home-btn {
            display: block;
            width: 250px;
            text-align: center;
            margin: 10px auto; /* جعلهم تحت بعض ومتوسطين */
            padding: 12px 24px;
            font-size: 24px;
            font-weight: bold;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
        }

        .play-again-btn {
            background: #4CAF50; /* أخضر */
            color: white;
        }

            .play-again-btn:hover {
                background: #45a049;
            }

        .back-home-btn {
            background: #2196F3; /* أزرق */
            color: white;
        }

            .back-home-btn:hover {
                background: #1e87db;
            }

        @@keyframes glow {
            from {
                text-shadow: 0 0 10px #ffcc00, 0 0 20px #ffcc00, 0 0 30px #ffcc00;
            }

            to {
                text-shadow: 0 0 20px #fff, 0 0 30px #fff, 0 0 40px #fff;
            }
        }

        @@keyframes popUp {
            0% {
                transform: scale(0);
                opacity: 0;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        /* 🎊 قصاقيص متساقطة */
        .confetti-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            pointer-events: none;
        }

        .confetti {
            position: absolute;
            width: 10px;
            height: 15px;
            background: red;
            opacity: 0.8;
            transform: rotate(45deg);
            animation: fall linear infinite;
        }

        @@keyframes fall {
            0% {
                transform: translateY(-100vh) rotate(0deg);
            }

            100% {
                transform: translateY(100vh) rotate(360deg);
            }
        }
    </style>
</body>
